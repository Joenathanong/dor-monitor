{
  "name": "dor-app",
  "version": "1.0.0",
  "private": true,
  "description": "IEG DOR - Daily Operation Review (Next.js 15 + Prisma + TiDB Serverless + Google Drive, deploy Vercel)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:collation": "tsx prisma/collation.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:passwd": "tsx prisma/passwd.ts",
    "check:drive": "tsx scripts/check-drive.ts",
    "setup": "prisma db push && tsx prisma/collation.ts && tsx prisma/seed.ts",
    "drive:auth": "tsx scripts/drive-auth.ts",
    "drive:diag": "node scripts/drive-diag.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "googleapis": "^144.0.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.474.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
