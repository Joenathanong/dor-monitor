# ── Database: TiDB Serverless (MySQL 8 compatible) ────────────────────────────
# Ambil dari TiDB Cloud → Connect → Prisma. WAJIB sslaccept=strict.
DATABASE_URL="mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/dor?sslaccept=strict"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimal 32 karakter acak. Ganti kalau ingin memaksa semua user login ulang.
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Masa berlaku sesi (hari)
AUTH_SESSION_DAYS=30

# ── Penyimpanan foto bukti ────────────────────────────────────────────────────
# gdrive = Google Drive (produksi, Vercel) · local = ./storage/uploads (dev saja)
STORAGE_DRIVER=gdrive

# Ada DUA cara autentikasi ke Drive — pilih salah satu:
#
# (A) OAuth akun Google biasa/Workspace — folder boleh di MY DRIVE.
#     Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#     → tipe "Desktop app". Isi 2 nilai di bawah, lalu jalankan `npm run drive:auth`:
#     skrip meminta izin scope drive.file (tanpa verifikasi Google), MEMBUAT folder
#     tujuan di My Drive, dan mencetak GDRIVE_OAUTH_REFRESH_TOKEN + GDRIVE_FOLDER_ID.
#     Folder yang dibuat manual tidak bisa dipakai di mode ini.
#     Bila GDRIVE_OAUTH_REFRESH_TOKEN terisi, mode OAuth yang dipakai.
GDRIVE_FOLDER_NAME="DOR Bukti Foto"
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=
#
# (B) Service Account — folder HARUS di SHARED DRIVE (service account tidak punya
#     kuota di My Drive). Tambahkan email service account sebagai Content manager.
# Service account JSON — tempel SELURUH isi file JSON dalam satu baris,
# atau isi GDRIVE_SA_BASE64 dengan base64 dari file JSON (lebih aman untuk Vercel).
GDRIVE_SA_JSON=
GDRIVE_SA_BASE64=
# ID folder tujuan (dari URL …/folders/<ID>). Mode A: My Drive boleh. Mode B: harus Shared Drive.
GDRIVE_FOLDER_ID=
# true  = file diberi izin "anyone with link: reader" agar <img> bisa memuat
#         langsung dari drive.google.com (tidak lewat server kita — ringan).
# false = foto dilayani lewat /api/attachments/[id] (stream via service account).
GDRIVE_PUBLIC_LINKS=true

# ── Seed admin pertama ────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@ptieg.co.id
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME="Administrator"
